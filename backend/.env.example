# ─── Server ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
# (your Vite dev server + your production domain)
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ───────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/truelife
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/truelife
MONGODB_URI=mongodb://127.0.0.1:27017/truelife

# ─── Auth (admin dashboard) ─────────────────────────────
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Razorpay (donations) ───────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email notifications (optional) ─────────────────────
# If set, new contact/volunteer submissions email this address.
# Leave blank to disable. Uses SMTP.
NOTIFY_EMAIL=singhabhijeet0021@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
